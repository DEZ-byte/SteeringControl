<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenSteer.Core</RootNamespace>
    <!-- Deliberately NO RuntimeIdentifier: Core stays portable so OpenSteer.Tests
         can consume it on any host. Invariant I16: no Win32, no sockets, no Console. -->
  </PropertyGroup>

</Project>
