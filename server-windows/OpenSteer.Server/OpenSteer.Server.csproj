<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows, not net8.0: this daemon calls ntdll, ViGEmBus and named
         shared memory. Declaring the platform once here lets the analyzer verify
         every call site instead of needing a SupportedOSPlatform attribute on each
         type that touches Win32. OpenSteer.Core stays plain net8.0 and portable. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Deployment: self-contained single-file ReadyToRun, not Native AOT.
         PublishAot's link step needs MSVC link.exe and the Windows SDK, and the build
         is kept free of a C++ toolchain. PublishReadyToRun (crossgen2) and
         PublishSingleFile (host bundler) need no C++ toolchain at all. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- OptimizationPreference is read by the AOT ILC compiler only and is inert in an
         R2R build. Kept because it costs nothing. -->
    <OptimizationPreference>Speed</OptimizationPreference>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenSteer.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSteer.Core\OpenSteer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precompiled native client, extracted from the official
         Nefarius.ViGEm.Client 1.21.256 NuGet package. ExcludeFromSingleFile keeps it
         a loose file beside the host, where NativeLibrary.SetDllImportResolver
         looks via AppContext.BaseDirectory. Without it, IncludeNativeLibrariesForSelfExtract
         bundles the DLL into the exe and extracts it under %TEMP%\.net at run time,
         where the resolver never looks. -->
    <None Include="..\..\third_party\vigem\ViGEmClient.dll"
          Link="ViGEmClient.dll"
          Condition="Exists('..\..\third_party\vigem\ViGEmClient.dll')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />

    <!-- Mode B is optional: Memory Integrity (HVCI) may refuse the vJoy driver.
         The Exists() guard keeps the build green when vJoy is not installed.
         Set VJoyDll on the command line, e.g.
         dotnet build -p:VJoyDll="C:\Program Files\vJoy\x64\vJoyInterface.dll" -->
    <None Include="$(VJoyDll)"
          Link="vJoyInterface.dll"
          Condition="'$(VJoyDll)' != '' And Exists('$(VJoyDll)')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The committed native binary is pinned. A swapped or corrupted DLL fails the
       build instead of loading. The value is the SHA-256 recorded in
       THIRD_PARTY_NOTICES.md for ViGEmClient 1.21.233.0 (x64, 141,312 bytes); change
       both together, and only when upgrading the DLL. MSBuild compares the two
       strings case-insensitively. Hooked to publish as well as build, so
       a publish that skips the build cannot ship a swapped file either. -->
  <Target Name="VerifyViGEmClientHash" BeforeTargets="BeforeBuild;PrepareForPublish"
          Condition="Exists('..\..\third_party\vigem\ViGEmClient.dll')">
    <GetFileHash Files="..\..\third_party\vigem\ViGEmClient.dll" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ViGEmClientSha256" />
    </GetFileHash>
    <Error Condition="'$(_ViGEmClientSha256)' != '00303F99E1968D523FBD08A7C691D60D145B7335059EC593947841D124C10875'"
           Text="third_party\vigem\ViGEmClient.dll has SHA-256 $(_ViGEmClientSha256), not the value pinned in THIRD_PARTY_NOTICES.md." />
  </Target>

</Project>
