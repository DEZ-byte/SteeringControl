root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows-native files: Visual Studio solutions, Windows scripts, and the Assetto
# Corsa preset, which sits beside the game's own CRLF files. Same list as the
# CRLF rules in .gitattributes.
[*.{sln,ps1,bat,cmd}]
end_of_line = crlf

[docs/sim-presets/**.ini]
end_of_line = crlf
